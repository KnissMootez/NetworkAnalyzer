{
  "python.defaultInterpreterPath": "${workspaceFolder}\\networkanalyzer-env\\Scripts\\python.exe",
  "terminal.integrated.defaultProfile.windows": "NetworkAnalyzer",
  "terminal.integrated.profiles.windows": {
    "NetworkAnalyzer": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned; & '${workspaceFolder}/networkanalyzer-env/Scripts/Activate.ps1'"
      ]
    }
  }
}
